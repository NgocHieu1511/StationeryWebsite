@model List<StationeryWebsite.Models.Order>

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<div class="container-fluid px-4">

    <h1 class="mt-4">Dashboard Admin</h1>

    <div class="row mt-4">

        <!-- Products -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <h4>@ViewBag.TotalProducts</h4>
                    <div>Tổng sản phẩm</div>
                </div>
            </div>
        </div>

        <!-- Users -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <h4>@ViewBag.TotalUsers</h4>
                    <div>Người dùng</div>
                </div>
            </div>
        </div>

        <!-- Orders -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <h4>@ViewBag.TotalOrders</h4>
                    <div>Đơn hàng</div>
                </div>
            </div>
        </div>

        <!-- Revenue -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white mb-4">
                <div class="card-body">
                    <h4>@String.Format("{0:N0} VNĐ", ViewBag.TotalRevenue)</h4>
                    <div>Doanh thu</div>
                </div>
            </div>
        </div>

    </div>

    <!-- Đơn hàng mới -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Đơn hàng mới nhất
        </div>

        <div class="card-body">

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.order_id</td>
                            <td>@item.date</td>
                            <td>
                                @String.Format("{0:N0} VNĐ", item.total_price)
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

    <!-- Sản phẩm sắp hết -->
    <div class="card mb-4">

        <div class="card-header">
            Sản phẩm sắp hết hàng
        </div>

        <div class="card-body">

            <table class="table table-striped">

                <thead>
                    <tr>
                        <th>Tên sản phẩm</th>
                        <th>Số lượng</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in ViewBag.LowStockProducts)
                    {
                        <tr>
                            <td>@item.name</td>
                            <td>@item.quantity</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>