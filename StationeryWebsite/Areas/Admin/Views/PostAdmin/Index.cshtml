@model List<StationeryWebsite.Models.Post>
@{
    ViewBag.Title = "Quản Lý Bài Viết";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<div class="container-fluid mt-4">
    <!-- Breadcrumb -->
    <div class="header-sub-title mb-3">
        <nav class="breadcrumb breadcrumb-dash">
            <a href="@Url.Action("Index","HomeAdmin", new { area = "Admin" })" class="breadcrumb-item">
                <i class="anticon anticon-home m-r-5"></i> Trang chủ
            </a>
            <span class="breadcrumb-item active">Quản lý bài viết</span>
        </nav>
    </div>

    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="fa fa-newspaper"></i> Danh sách bài viết
            </h4>
            <a href="@Url.Action("Create")" class="btn btn-light">
                <i class="fa fa-plus"></i> Thêm bài viết
            </a>
        </div>

        <div class="card-body">
            <!-- Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fa fa-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="fa fa-exclamation-circle"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Search -->
            <div class="row mb-3">
                <div class="col-md-6">
                    @using (Html.BeginForm("Index", "PostAdmin", FormMethod.Get))
                    {
                        <div class="input-group">
                            <input type="text" name="search" class="form-control"
                                   placeholder="Tìm kiếm bài viết..." value="@ViewBag.Search">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    }
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">Tất cả trạng thái</option>
                        <option value="active" @(ViewBag.Status == "active" ? "selected" : "")>Đang hiển thị</option>
                        <option value="inactive" @(ViewBag.Status == "inactive" ? "selected" : "")>Đã ẩn</option>
                    </select>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th width="5%">ID</th>
                            <th width="25%">Tiêu đề</th>
                            <th width="15%">Ảnh</th>
                            <th width="10%">Trạng thái</th>
                            
                            <th width="15%">Ngày tạo</th>
                            <th width="20%">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="fa fa-newspaper fa-2x mb-2"></i>
                                    <p>Chưa có bài viết nào</p>
                                    <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">Thêm bài viết mới</a>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var post in Model)
                            {
                                <tr>
                                    <td>@post.post_id</td>
                                    <td>
                                        <a href="@Url.Action("Detail", "Blog", new { area = "", slug = post.slug })"
                                           target="_blank" class="fw-bold text-decoration-none">
                                            @post.title
                                        </a>
                                        @if (!string.IsNullOrEmpty(post.summary))
                                        {
                                            <br><small class="text-muted">@post.summary</small>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(post.image))
                                        {
                                            <img src="@post.image" style="width:60px;height:60px;object-fit:cover;border-radius:4px;">
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có ảnh</span>
                                        }
                                    </td>
                                    <td>
                                        @if (post.is_active == true)
                                        {
                                            <span class="badge bg-success">Hiển thị</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Đã ẩn</span>
                                        }
                                    </td>
                                    
                                    <td>@post.created_at</td>
                                    <td>
                                        <a href="@Url.Action("Edit", new { id = post.post_id })"
                                           class="btn btn-warning btn-sm" title="Sửa">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Detail", "Blog", new { area = "", slug = post.slug })"
                                           class="btn btn-info btn-sm" target="_blank" title="Xem">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        <button class="btn btn-danger btn-sm"
                                                onclick="deletePost(@post.post_id)" title="Xóa">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Form xóa ẩn -->
@using (Html.BeginForm("Delete", "PostAdmin", FormMethod.Post, new { id = "deleteForm" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId">
}

@section Scripts {
    <script>
        function deletePost(id) {
            if (confirm('Bạn có chắc muốn xóa bài viết #' + id + '? Hành động này không thể hoàn tác!')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}