@model StationeryWebsite.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <!-- Breadcrumb -->
    <div class="header-sub-title mb-3">
        <nav class="breadcrumb breadcrumb-dash">
            <a href="@Url.Action("Index","HomeAdmin", new { area = "Admin" })" class="breadcrumb-item">
                <i class="anticon anticon-home m-r-5"></i> Trang chủ
            </a>

            <a href="@Url.Action("Index","Products")" class="breadcrumb-item">
                Quản lý sản phẩm
            </a>

            <span class="breadcrumb-item active">Chi tiết sản phẩm</span>
        </nav>
    </div>

    <div class="card shadow border-0">

        <div class="card-header bg-info text-white">
            <h4 class="mb-0">
                <i class="fa fa-eye"></i> Chi tiết sản phẩm
            </h4>
        </div>

        <div class="card-body">

            <div class="row">

                <!-- Ảnh -->
                <div class="col-md-4 text-center mb-4">
                    <img src="@Url.Content( Model.image)"
                         class="img-fluid rounded border p-2"
                         style="max-height:300px;" />

                    <h5 class="mt-3 fw-bold">@Model.name</h5>

                    @if (Model.status == true)
                    {
                        <span class="badge bg-success px-3 py-2">Đang bán</span>
                    }
                    else
                    {
                        <span class="badge bg-danger px-3 py-2">Ẩn</span>
                    }
                </div>

                <!-- Thông tin -->
                <div class="col-md-8">

                    <table class="table table-bordered table-striped">
                        <tr>
                            <th width="220">Tên sản phẩm</th>
                            <td>@Model.name</td>
                        </tr>

                        <tr>
                            <th>Danh mục</th>
                            <td>@Model.Category.name</td>
                        </tr>

                        <tr>
                            <th>Giá bán</th>
                            <td class="text-danger fw-bold">
                                @String.Format("{0:N0} đ", Model.price)
                            </td>
                        </tr>

                        <tr>
                            <th>Giảm giá</th>
                            <td>@Model.discount %</td>
                        </tr>

                        <tr>
                            <th>Số lượng tồn</th>
                            <td>@Model.quantity</td>
                        </tr>

                        <tr>
                            <th>Đã bán</th>
                            <td>@Model.sold_quantity</td>
                        </tr>

                        <tr>
                            <th>Thương hiệu</th>
                            <td>@Model.brand</td>
                        </tr>

                        <tr>
                            <th>Đơn vị tính</th>
                            <td>@Model.calculation_unit</td>
                        </tr>

                        <tr>
                            <th>Ngày tạo</th>
                            <td>@Model.created_at</td>
                        </tr>

                        <tr>
                            <th>Mô tả</th>
                            <td>@Model.description</td>
                        </tr>

                        <tr>
                            <th>Thông số kỹ thuật</th>
                            <td>@Model.specification</td>
                        </tr>

                    </table>

                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-between">

                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Quay lại
                </a>

                <a href="@Url.Action("Edit", new { id = Model.product_id })"
                   class="btn btn-warning">
                    <i class="fa fa-edit"></i> Chỉnh sửa
                </a>

            </div>

        </div>

    </div>

</div>