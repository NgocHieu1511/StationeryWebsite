@model StationeryWebsite.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <!-- Breadcrumb -->
    <div class="header-sub-title mb-3">
        <nav class="breadcrumb breadcrumb-dash">
            <a href="@Url.Action("Index","HomeAdmin", new { area = "Admin" })" class="breadcrumb-item">
                <i class="anticon anticon-home m-r-5"></i> Trang chủ
            </a>

            <a href="@Url.Action("Index","Products")" class="breadcrumb-item">
                Quản lý sản phẩm
            </a>

            <span class="breadcrumb-item active">Xóa sản phẩm</span>
        </nav>
    </div>

    <div class="card shadow border-0">

        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">
                <i class="fa fa-trash"></i> Xóa sản phẩm
            </h4>
        </div>

        <div class="card-body">

            <!-- Alert -->
            <div class="alert alert-warning">
                <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa sản phẩm này không?
                Hành động này không thể hoàn tác.
            </div>

            <div class="row">

                <!-- Ảnh -->
                <div class="col-md-4 text-center mb-4">
                    <img src="@Url.Content(Model.image)"
                         class="img-fluid rounded border p-2"
                         style="max-height:280px;" />

                    <h5 class="mt-3 fw-bold">@Model.name</h5>
                </div>

                <!-- Thông tin -->
                <div class="col-md-8">

                    <table class="table table-bordered table-striped">
                        <tr>
                            <th width="220">Tên sản phẩm</th>
                            <td>@Model.name</td>
                        </tr>

                        <tr>
                            <th>Danh mục</th>
                            <td>@Model.Category.name</td>
                        </tr>

                        <tr>
                            <th>Giá bán</th>
                            <td class="text-danger fw-bold">
                                @String.Format("{0:N0} đ", Model.price)
                            </td>
                        </tr>

                        <tr>
                            <th>Giảm giá</th>
                            <td>@Model.discount %</td>
                        </tr>

                        <tr>
                            <th>Số lượng tồn</th>
                            <td>@Model.quantity</td>
                        </tr>

                        <tr>
                            <th>Đã bán</th>
                            <td>@Model.sold_quantity</td>
                        </tr>

                        <tr>
                            <th>Thương hiệu</th>
                            <td>@Model.brand</td>
                        </tr>

                        <tr>
                            <th>Đơn vị tính</th>
                            <td>@Model.calculation_unit</td>
                        </tr>

                        <tr>
                            <th>Ngày tạo</th>
                            <td>@Model.created_at</td>
                        </tr>

                        <tr>
                            <th>Trạng thái</th>
                            <td>
                                @if (Model.status == true)
                                {
                                    <span class="badge bg-success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ẩn</span>
                                }
                            </td>
                        </tr>

                    </table>

                </div>

            </div>

            <hr />

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-between">

                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Quay lại
                    </a>

                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fa fa-trash"></i> Xác nhận xóa
                    </button>

                </div>
            }

        </div>

    </div>

</div>