
@model StationeryWebsite.Models.Product

@{
    ViewBag.Title = "Thêm sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <!-- Breadcrumb -->
    <div class="header-sub-title mb-3">
        <nav class="breadcrumb breadcrumb-dash">
            <a href="@Url.Action("Index","HomeAdmin", new { area = "Admin" })" class="breadcrumb-item">
                <i class="anticon anticon-home m-r-5"></i> Trang chủ
            </a>
            <a href="@Url.Action("Index","Products")" class="breadcrumb-item">
                Quản lý sản phẩm
            </a>
            <span class="breadcrumb-item active">Thêm sản phẩm</span>
        </nav>
    </div>

    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="fa fa-plus-circle"></i> Thêm sản phẩm mới
            </h4>
        </div>

        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="row">

                <!-- Tên -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Tên sản phẩm</label>
                    @Html.EditorFor(model => model.name, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <!-- Giá -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Giá</label>
                    @Html.EditorFor(model => model.price, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <!-- ẢNH -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Hình ảnh</label>

                    <div class="input-group">
                        @Html.TextBoxFor(model => model.image,
                            new { @class = "form-control", id = "txtImage" })

                        <button type="button"
                                class="btn btn-primary"
                                onclick="BrowseServer();">
                            Chọn ảnh
                        </button>
                    </div>

                    <img id="previewImage"
                         style="margin-top:10px;width:120px;display:none;" />
                </div>

                <!-- Danh mục -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Danh mục</label>
                    @Html.DropDownList("category_id", null, "-- Chọn danh mục --", new { @class = "form-select" })
                </div>

                <!-- Thương hiệu -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Thương hiệu</label>
                    @Html.EditorFor(model => model.brand, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <!-- Đơn vị tính -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Đơn vị tính</label>
                    @Html.EditorFor(model => model.calculation_unit, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <!-- Giảm giá -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Giảm giá (%)</label>
                    @Html.EditorFor(model => model.discount, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <!-- Tồn kho -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Số lượng</label>
                    @Html.EditorFor(model => model.quantity, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <!-- Đã bán -->
                @*<div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Đã bán</label>
            @Html.EditorFor(model => model.sold_quantity, new { htmlAttributes = new { @class = "form-control" } })
        </div>*@

                <!-- Trạng thái -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold d-block">Trạng thái</label>
                    <div class="form-check mt-2">
                        @Html.CheckBoxFor(model => model.status, new { @class = "form-check-input" })
                        <label class="form-check-label">Hiển thị sản phẩm</label>
                    </div>
                </div>
                <!-- Nhãn sản phẩm -->
                <div class="col-md-12 mb-3">
                    <label class="form-label fw-bold d-block">Nhãn sản phẩm</label>
                    <div class="d-flex gap-4 flex-wrap mt-2">

                        <div class="form-check form-check-inline">
                            @Html.CheckBoxFor(model => model.is_hot, new { @class = "form-check-input", id = "labelHot" })
                            <label class="form-check-label" for="labelHot">
                                <span class="badge bg-danger fs-6 px-3 py-2">
                                    <i class="fa fa-fire me-1"></i> Hot
                                </span>
                            </label>
                        </div>

                        <div class="form-check form-check-inline">
                            @Html.CheckBoxFor(model => model.is_featured, new { @class = "form-check-input", id = "labelFeatured" })
                            <label class="form-check-label" for="labelFeatured">
                                <span class="badge bg-primary fs-6 px-3 py-2">
                                    <i class="fa fa-star me-1"></i> Nổi bật
                                </span>
                            </label>
                        </div>

                        <div class="form-check form-check-inline">
                            @Html.CheckBoxFor(model => model.is_sale, new { @class = "form-check-input", id = "labelSale" })
                            <label class="form-check-label" for="labelSale">
                                <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                    <i class="fa fa-tag me-1"></i> Khuyến mãi
                                </span>
                            </label>
                        </div>

                    </div>
                </div>


                <!-- Mô tả -->
                <div class="col-md-12 mb-3">
                    <label class="form-label fw-bold">Mô tả</label>

                    @Html.TextAreaFor(model => model.description,
                    new
                    {
                        @class = "form-control",
                        id = "inputMoTa",
                        rows = 6
                    })
                </div>

                <!-- Thông số -->
                <div class="col-md-12 mb-3">
                    <label class="form-label fw-bold">Thông số kỹ thuật</label>
                    @Html.TextAreaFor(model => model.specification, new { @class = "form-control", rows = 4 })
                </div>

            </div>

                <hr />

                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Quay lại
                    </a>

                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa fa-save"></i> Lưu sản phẩm
                    </button>
                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    <script>
        window.onload = function () {
            CKEDITOR.replace('inputMoTa');
        }
        function BrowseServer() {
            var finder = new CKFinder();

            finder.selectActionFunction = function (url) {

                document.getElementById("txtImage").value = url;

                document.getElementById("previewImage").src = url;
                document.getElementById("previewImage").style.display = "block";
            };

            finder.popup();
        }
    </script>
}

