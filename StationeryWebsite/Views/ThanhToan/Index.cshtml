@model List<StationeryWebsite.Models.Cart>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- TITLE BANNER START -->
<section class="title-banner bg-sec">
    <div class="container-2">
        <div class="title-wrapper">
            <div class="row align-items-center justify-content-between">

                <div class="col-lg-6 col-md-6 col-sm-6">
                    <h1 class="fw-700 medium-black text-sm-start text-center">
                        Checkout
                    </h1>
                </div>

                <div class="col-lg-6 col-md-6 col-sm-6 d-sm-block d-none">
                    <div class="text-end">
                        <img src="@Url.Content("~/Assets/Client/assets/media/banner/title-banner-image.png")"
                             alt="Checkout Banner">
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
<!-- TITLE BANNER END -->
<!-- CHECKOUT FORM START -->
@using (Html.BeginForm("PlaceOrder", "ThanhToan", FormMethod.Post, new { id = "checkoutForm" }))
{
    @Html.AntiForgeryToken()
    <section class="billing-detail pb-80">
        <div class="container-2">
            <div class="row row-gap-4">

                <!-- LEFT -->
                <div class="col-xl-8">

                    <div class="title-row title-row-2 bg-white mb-16">
                        <h5 class="fw-600 medium-black">Billing Details</h5>
                    </div>

                    <!-- BILLING -->
                    <div class="billing-wrapper bg-white br-10 mb-40">
                        <div class="row">

                            <div class="col-md-6">
                                <input type="text" name="first_name" class="form-control form-control-2 mb-16" placeholder="Họ">
                            </div>

                            <div class="col-md-6">
                                <input type="text" name="last_name" class="form-control form-control-2 mb-16" placeholder="Tên">
                            </div>

                            <div class="col-md-6">
                                <input type="email" name="email" class="form-control form-control-2 mb-16" placeholder="Email">
                            </div>

                            <div class="col-md-6">
                                <input type="tel" name="phone" class="form-control form-control-2 mb-16" placeholder="Số điện thoại">
                            </div>

                            <div class="col-md-12">
                                <input type="text" name="address" class="form-control form-control-2 mb-16" placeholder="Số nhà, đường">
                            </div>

                            <div class="col-md-6">
                                <input type="text" name="ward" class="form-control form-control-2 mb-16" placeholder="Phường/Xã">
                            </div>

                            <div class="col-md-6">
                                <input type="text" name="district" class="form-control form-control-2 mb-16" placeholder="Quận/Huyện">
                            </div>

                            <div class="col-md-12">
                                <select name="province" class="form-control form-control-2 mb-16">
                                    <option value="">Chọn Tỉnh/Thành</option>
                                    <option value="HN">Hà Nội</option>
                                    <option value="HCM">Hồ Chí Minh</option>
                                    <option value="DN">Đà Nẵng</option>
                                    <option value="HP">Hải Phòng</option>
                                </select>
                            </div>

                        </div>
                    </div>

                    <!-- SHIPPING -->
                    <div class="title-row title-row-2 mb-16">
                        <h5 class="fw-600 medium-black">Shipping Methods</h5>
                    </div>

                    <div class="shipping-radio-container mb-40">

                        <label>
                            <input type="radio" name="shipping_fee" value="15000" checked>
                            Giao tiêu chuẩn - 15.000đ
                        </label><br>

                        <label>
                            <input type="radio" name="shipping_fee" value="35000">
                            Giao nhanh - 35.000đ
                        </label><br>

                        <label>
                            <input type="radio" name="shipping_fee" value="60000">
                            Hỏa tốc - 60.000đ
                        </label>

                    </div>

                    <!-- PAYMENT -->
                    <div class="title-row title-row-2 mb-16">
                        <h5 class="fw-600 medium-black">Payment Methods</h5>
                    </div>

                    <div class="shipping-radio-container mb-40">

                        <label><input type="radio" name="payment_method" value="card" checked> Thẻ tín dụng</label><br>
                        <label><input type="radio" name="payment_method" value="paypal"> Paypal</label><br>
                        <label><input type="radio" name="payment_method" value="bank"> Chuyển khoản</label><br>
                        <label><input type="radio" name="payment_method" value="cod"> COD</label>

                    </div>

                    <!-- CARD DETAILS -->
                    <div>
                        <h5 class="fw-600 medium-black mb-24">Payment Details</h5>

                        <input type="text" name="card_number" class="form-control mb-16" placeholder="Số thẻ">

                        <input type="text" name="card_expiry" class="form-control mb-16" placeholder="MM/YY">

                        <input type="text" name="cvv" class="form-control mb-16" placeholder="CVV">

                        <input type="text" name="card_holder" class="form-control mb-16" placeholder="Tên chủ thẻ">
                    </div>

                </div>

                <!-- RIGHT -->
                <div class="col-xl-4">

                    <div class="title-row title-row-2 mb-16">
                        <h5 class="fw-600 medium-black">Order Summary</h5>
                    </div>

                    <div class="summary-container bg-white">

                        @foreach (var item in Model)
                        {
                            <div class="item-container mb-16">
                                <div>
                                    <img src="@item.Product.image" style="width:60px">
                                    <b>@item.Product.name</b> x @item.quantity
                                </div>
                                <div>
                                    @((item.quantity * item.Product.price).ToString("N0"))đ
                                </div>
                            </div>
                        }

                        <hr />

                        <div class="d-flex justify-content-between">
                            <span>Tạm tính</span>
                            <span>
                                @((Model.Sum(c => c.quantity * c.Product.price)).ToString("N0"))đ
                            </span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span>Phí ship</span>
                            <span>15.000đ</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <b>Tổng cộng</b>
                            <b>
                                @((Model.Sum(c => c.quantity * c.Product.price) + 15000).ToString("N0"))đ
                            </b>
                        </div>

                        <hr />

                        <input type="text" name="coupon" class="form-control mb-16" placeholder="Mã giảm giá">

                        <!-- SUBMIT -->
                        <button type="submit" class="cus-btn border-0 w-100">
                            Đặt hàng ngay
                        </button>

                    </div>

                </div>

            </div>
        </div>
    </section>
}
<!-- CHECKOUT FORM END -->