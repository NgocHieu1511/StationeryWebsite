@model StationeryWebsite.Models.Order
@{
    ViewBag.Title = "Đặt Hàng Thành Công";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    var shippingAddress = ViewBag.ShippingAddress as StationeryWebsite.Models.Address;
}

<section class="success-section py-80">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="text-center mb-40">
                    <i class="fas fa-check-circle text-success" style="font-size: 80px;"></i>
                    <h2 class="fw-700 mt-16">Đặt Hàng Thành Công!</h2>
                    <p class="text-muted">Cảm ơn bạn đã mua hàng. Đơn hàng của bạn đang được xử lý.</p>
                </div>

                <div class="card br-10 mb-24">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Thông Tin Đơn Hàng #@Model.order_id</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Ngày đặt:</strong> @Model.date.ToString("dd/MM/yyyy HH:mm")</p>
                        <p><strong>Trạng thái:</strong> @Model.Order_status.description</p>
                        <p><strong>Phương thức thanh toán:</strong> @ViewBag.PaymentMethod</p>

                        @if (shippingAddress != null)
                        {
                            <p><strong>Địa chỉ giao hàng:</strong></p>
                            <p>
                                @shippingAddress.specific_address<br>
                                @shippingAddress.ward_name, @shippingAddress.district_name<br>
                                @shippingAddress.province_name
                            </p>
                        }

                        <hr>

                        <h6>Sản phẩm đã đặt:</h6>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.Order_detail)
                                {
                                    <tr>
                                        <td>@detail.Product.name</td>
                                        <td>@detail.quantity</td>
                                        <td>@detail.item_price.ToString("N0")đ</td>
                                        <td>@((detail.quantity * detail.item_price).ToString("N0"))đ</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Phí ship:</strong></td>
                                    <td>@(((decimal)ViewBag.ShippingFee).ToString("N0"))đ</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Tổng cộng:</strong></td>
                                    <td><strong class="text-danger">@Model.total_price.ToString("N0")đ</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="text-center">
                    <a href="@Url.Action("Index", "Home")" class="cus-btn me-2">
                        <i class="fas fa-home me-2"></i>Về Trang Chủ
                    </a>
                    <a href="@Url.Action("Index", "QuanLyDonHang")" class="cus-btn cus-btn-2">
                        <i class="fas fa-list me-2"></i>Xem Đơn Hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<style>
    .cus-btn {
        background-color: #FF6B35 !important;
        color: #fff !important;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .cus-btn i,
        .cus-btn span {
            color: #fff !important;
        }

        .cus-btn:hover {
            background-color: #e85a2a !important;
            color: #fff !important;
        }

            .cus-btn:hover i,
            .cus-btn:hover span {
                color: #fff !important;
            }

        .cus-btn::before,
        .cus-btn::after {
            display: none !important;
        }
   
</style>