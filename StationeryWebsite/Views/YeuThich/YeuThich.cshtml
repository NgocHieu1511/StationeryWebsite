@model List<StationeryWebsite.Models.WishlistItem>

@{
    ViewBag.Title = "YeuThich";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- TITLE BANNER START -->
<section class="title-banner bg-sec">
    <div class="container-2">

        <div class="title-wrapper">

            <div class="row align-items-center justify-content-between">

                <div class="col-lg-6 col-md-6 col-sm-6">
                    <h1 class="fw-700 medium-black text-sm-start text-center">
                        Sản phẩm yêu thích
                    </h1>
                </div>

                <div class="col-lg-6 col-md-6 col-sm-6 d-sm-block d-none">
                    <div class="text-end">

                        <img src="@Url.Content("~/Assets/Client/assets/media/banner/title-banner-image.png")"
                             alt="">

                    </div>
                </div>

            </div>

        </div>

    </div>
</section>
<!-- TITLE BANNER END -->
<!-- Wishlist Area Start -->
<section class="cart py-40">

    <div class="container-2">

        @if (Model != null && Model.Count > 0)
        {

            <div class="d-lg-block d-none">

                <table class="cart-table wishlist mb-16">

                    <thead>

                        <tr>
                            <th>Tên sản phẩm</th>
                            <th>Giá</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>

                    </thead>

                </table>

                <table class="cart-table">

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr class="table-row wishlist-row">

                                <td class="pd">

                                    <div class="product-detail-box">

                                        <!-- Remove -->
                                        <a href="@Url.Action("Remove","YeuThich",
                                                new { id = item.ProductID })"
                                           class="h5 dark-black">

                                            <i class="fal fa-times"></i>

                                        </a>

                                        <!-- Image -->
                                        <div class="img-block">

                                            <a href="@Url.Action("Details","SanPham",
                                                    new { id = item.ProductID })">

                                                <img src="@Url.Content(item.Image)"
                                                     alt="@item.ProductName">

                                            </a>

                                        </div>

                                        <!-- Name -->
                                        <div class="d-block text-start">

                                            <h6>

                                                <a href="@Url.Action("Details","SanPham",
                                                        new { id = item.ProductID })"
                                                   class="medium-black fw-600">

                                                    @item.ProductName

                                                </a>

                                            </h6>

                                        </div>

                                    </div>

                                </td>

                                <!-- Price -->
                                <td>

                                    <p class="fw-500">
                                        @String.Format("{0:N0} đ", item.Price)
                                    </p>

                                </td>

                                <!-- Stock -->
                                <td>

                                    <p class="fw-500 stock-label m-auto">
                                        Còn hàng
                                    </p>

                                </td>

                                <!-- Button -->
                                <td>

                                    <a href="@Url.Action("Index","Cart")"
                                       class="cus-btn">

                                        <span class="btn-text">
                                            Thêm vào giỏ hàng
                                        </span>

                                        <span>
                                            Thêm vào giỏ hàng
                                        </span>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- Mobile -->
            <div class="d-lg-none d-block">

                <div class="row">

                    @foreach (var item in Model)
                    {
                        <div class="col-md-6">

                            <div class="cart-item-block mb-32">

                                <div class="img-block mb-16">

                                    <a href="@Url.Action("Details","SanPham",
                                            new { id = item.ProductID })">

                                        <img src="@Url.Content(item.Image)"
                                             alt="@item.ProductName">

                                    </a>

                                    <a href="@Url.Action("Remove","YeuThich",
                                            new { id = item.ProductID })"
                                       class="cross">

                                        <i class="fal fa-times"></i>

                                    </a>

                                </div>

                                <h6 class="fw-600 mb-24">
                                    @item.ProductName
                                </h6>

                                <ul class="unstyled detail">

                                    <li>

                                        <h6 class="font-primary">
                                            Giá
                                        </h6>

                                        <h6 class="font-primary">
                                            @String.Format("{0:N0} đ", item.Price)
                                        </h6>

                                    </li>

                                    <li>

                                        <h6 class="font-primary">
                                            Stock Status
                                        </h6>

                                        <h6 class="font-primary">
                                            In Stock
                                        </h6>

                                    </li>

                                    <li>

                                        <a href="@Url.Action("Index","Cart")"
                                           class="cus-btn">

                                            <span class="btn-text">
                                                Thêm vào giỏ hàng
                                            </span>

                                            <span>
                                                Thêm vào giỏ hàng
                                            </span>

                                        </a>

                                    </li>

                                </ul>

                            </div>

                        </div>
                    }

                </div>

            </div>

            <!-- Total -->
            <div class="table-bottom-row varient-2 bg-white">

                <h5 class="medium-black fw-600 py-40 text-end">

                    Tổng:
                    @String.Format("{0:N0} đ", Model.Sum(x => x.Price))

                </h5>

            </div>

        }
        else
        {
            <div class="text-center py-80">

                <h3 class="mb-24">
                    Chưa có sản phẩm yêu thích
                </h3>

                <a href="@Url.Action("Index","Home")"
                   class="cus-btn">

                    <span class="btn-text">
                        Mua sắm ngay
                    </span>

                    <span>
                        Đi đến trang chủ
                    </span>

                </a>

            </div>
        }

    </div>

</section>
<!-- Wishlist Area End -->