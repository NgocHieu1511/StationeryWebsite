@{
    ViewBag.Title = "LienHe";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- TITLE BANNER START -->
<section class="title-banner bg-sec">

    <div class="container-2">

        <div class="title-wrapper">

            <div class="row align-items-center justify-content-between">

                <!-- TITLE -->
                <div class="col-lg-6 col-md-6 col-sm-6">

                    <h1 class="fw-700 medium-black text-sm-start text-center">
                        Liên hệ
                    </h1>

                </div>

                <!-- BANNER IMAGE -->
                <div class="col-lg-6 col-md-6 col-sm-6 d-sm-block d-none">

                    <div class="text-end">

                        <img src="@Url.Content("~/Assets/Client/assets/media/banner/title-banner-image.png")"
                             alt="Contact Banner">

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
<!-- TITLE BANNER END -->
<!-- CONTACT SECTION START -->
<section class="contact-sec py-40 my-40">

    <div class="container-2">

        <div class="row row-gap-4 align-items-stretch">

            <!-- FORM -->
            <div class="col-xl-6 col-lg-7 wow fadeInUp animated"
                 data-wow-delay="500ms">

                <div class="contact-form-wrapper">

                    <div class="heading mb-32">

                        <h2 class="fw-700 medium-black mb-16">
                            Get in Touch
                        </h2>

                        <p>
                            Open Mon-Fri 10 AM-9 PM,
                            Sat 10-6 PM, Closed on Sundays.
                        </p>

                    </div>

                    <form method="post" class="contact-form">

                        <div class="row row-gap-3">

                            <!-- NAME -->
                            <div class="col-lg-6 col-md-6">

                                <label for="fname"
                                       class="subtitle mb-8">
                                    Your Name
                                </label>

                                <div class="input-block">

                                    <input type="text"
                                           class="form-control"
                                           id="fname"
                                           name="name"
                                           required
                                           placeholder="John Doe">

                                </div>

                            </div>

                            <!-- EMAIL -->
                            <div class="col-lg-6 col-md-6">

                                <label for="eMail"
                                       class="subtitle mb-8">
                                    Your Email
                                </label>

                                <div class="input-block">

                                    <input type="email"
                                           class="form-control"
                                           id="eMail"
                                           name="email"
                                           required
                                           placeholder="exampleinfo@gmail.com">

                                </div>

                            </div>

                            <!-- MESSAGE -->
                            <div class="col-lg-12">

                                <label for="comment"
                                       class="subtitle mb-8">
                                    Special Message
                                </label>

                                <textarea name="message"
                                          id="comment"
                                          class="form-control"
                                          placeholder="Write your message here..."></textarea>

                            </div>

                            <!-- CHECKBOX -->
                            <div class="col-lg-12">

                                <div class="cus-checkBox mb-16">

                                    <input type="checkbox" id="remember">

                                    <label for="remember">
                                        I consent to the collection
                                        and storage of my data.
                                    </label>

                                </div>

                            </div>

                            <!-- BUTTON -->
                            <div class="col-xl-4 col-lg-6">

                                <button type="submit" class="cus-btn">

                                    <span class="text-btn">
                                        Send Message
                                    </span>

                                    <span>
                                        Send Message
                                    </span>

                                </button>

                                <div id="message"
                                     class="alert-msg"></div>

                            </div>

                        </div>

                    </form>

                </div>

            </div>


            <!-- GOOGLE MAP -->
            <div class="col-xl-6 col-lg-5 wow fadeInLeft animated"
                 data-wow-delay="400ms">

                <div class="map-wrapper">

                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3724.678039317082!2d105.84117107508177!3d21.02851108784161!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135abecb6f529d7%3A0x8ff0b1b8e6e2f5d4!2zSOG7kyBHw7htLCBIw6AgTuG7mWk!5e0!3m2!1svi!2svn!4v1716550000000"
                            class="google-map"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>

                </div>

            </div>

        </div>

    </div>

</section>
<!-- CONTACT SECTION END -->
