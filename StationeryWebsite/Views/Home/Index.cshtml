@*QUẢN LÝ PHẢN HỒI*@
<!-- TESTIMONIALS SECTION START -->
@{
    var reviews = ViewBag.Reviews as List<StationeryWebsite.Models.Feedback>;
}

<section class="testimonials-sec pt-40 pb-80">

    <div class="container-2">

        <div class="heading mb-48 text-center wow fadeInUp animated">

            <h2 class="medium-black fw-700 mb-16">
                Customer <span class="color-primary"> Reviews</span>
            </h2>

            <p>
                Khách hàng nói gì về sản phẩm của chúng tôi
            </p>

        </div>

        <div class="row row-gap-sm-4 row-gap-3">

            @if (reviews != null && reviews.Count > 0)
            {
                foreach (var item in reviews)
                {
                    <div class="col-lg-4 col-md-6 col-sm-6 wow fadeInUp animated">

                        <div class="testimonials-block p-24 bg-sec br-12 h-100">

                            <!-- STAR -->
                            <div class="rating-star mb-16">

                                <h6 class="color-star">

                                    @{
                                        int vote = item.vote ?? 0;
                                    }

                                    @for (int i = 1; i <= vote; i++)
                                    {
                                        @:★
                                    }

                                </h6>

                            </div>

                            <!-- COMMENT -->
                            <p class="mb-24">

                                @item.comment

                            </p>

                            <!-- USER -->
                            <p class="fw-600 medium-black mb-1">

                                - @item.User.username

                            </p>

                            <!-- PRODUCT -->
                            <small class="text-muted">

                                @item.Product.name

                            </small>

                        </div>

                    </div>
                }
            }
            else
            {
                <p>Chưa có đánh giá nào.</p>
            }

        </div>

    </div>

</section>
<!-- TESTIMONIALS SECTION END -->
