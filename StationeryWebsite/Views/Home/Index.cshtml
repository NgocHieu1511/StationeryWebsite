
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Phần Content -->
<!-- Main Sections -->
<section class="hero-banner">
    <div class="container-2">
        <div class="hero-banner-wrapper">
            <img src="@Url.Content("~/Assets/Client/assets/media/banner/hero-element.png")"
                 alt=""
                 class="element-1" />
            <img src="@Url.Content("~/Assets/Client/assets/media/banner/hero-element-2.png")"
                 alt=""
                 class="element-2" />
            <img src="@Url.Content("~/Assets/Client/assets/media/banner/hero-element-3.png")"
                 alt=""
                 class="element-3" />
            <div class="row align-items-center row-gap-4">
                <div class="col-lg-6 col-md-6">
                    <div class="hero-content-block">
                        <h1 class="medium-black fw-700 mb-16 wow fadeInLeft animated"
                            data-wow-delay="1900ms">
                            <span class="color-primary"> Stationery </span> That
                            <br class="d-lg-block d-none" />
                            Inspires Productivity.
                        </h1>
                        <p class="mb-32 wow fadeInLeft animated"
                           data-wow-delay="1900ms">
                            Inspire your customers by illustrating a sophisticated
                            <br class="d-lg-block d-none" />
                            lifestyle made possible through their purchases.
                        </p>
                        <a href="@Url.Action("Index", "Home")" class="cus-btn">
                            <span class="btn-text">Shop Now</span>
                            <span>Go to Shop</span>
                        </a>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6">
                    <div class="hero-image">
                        <img src="@Url.Content("~/Assets/Client/assets/media/banner/hero-image.png")"
                             alt=""
                             class="w-100" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
