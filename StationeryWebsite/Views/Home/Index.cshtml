@*QUẢN LÝ PHẢN HỒI*@
<!-- TESTIMONIALS SECTION START -->
@{
    var reviews = ViewBag.Reviews as List<StationeryWebsite.Models.Feedback>;
}

<section class="testimonials-sec pt-40 pb-80">

    <div class="container-2">

        <div class="heading mb-48 text-center wow fadeInUp animated">

            <h2 class="medium-black fw-700 mb-16">
                Customer <span class="color-primary"> Reviews</span>
            </h2>

            <p>
                Khách hàng nói gì về sản phẩm của chúng tôi
            </p>

        </div>

        <div class="row row-gap-sm-4 row-gap-3">

            @if (reviews != null && reviews.Count > 0)
            {
                foreach (var item in reviews)
                {
                    <div class="col-lg-4 col-md-6 col-sm-6 wow fadeInUp animated">

                        <div class="testimonials-block p-24 bg-sec br-12 h-100">

                            <!-- STAR -->
                            <div class="rating-star mb-16">

                                <h6 class="color-star">

                                    @{
                                        int vote = item.vote ?? 0;
                                    }

                                    @for (int i = 1; i <= vote; i++)
                                    {
                                        @:★
                                    }

                                </h6>

                            </div>

                            <!-- COMMENT -->
                            <p class="mb-24">

                                @item.comment

                            </p>

                            <!-- USER -->
                            <p class="fw-600 medium-black mb-1">

                                - @item.User.username

                            </p>

                            <!-- PRODUCT -->
                            <small class="text-muted">

                                @item.Product.name

                            </small>

                        </div>

                    </div>
                }
            }
            else
            {
                <p>Chưa có đánh giá nào.</p>
            }

        </div>

    </div>

</section>
<!-- TESTIMONIALS SECTION END -->
@*HẾT QYARN LÝ PHẢN HỒI-LÀM SAU*@
<!-- BLOG SECTION START -->
<section class="blog-section pt-80 pb-40">

    <div class="container-2">

        <div class="heading mb-48 text-center wow fadeInUp animated"
             data-wow-delay="400ms">

            <h2 class="medium-black fw-700 mb-16">
                Bài Viết <span class="color-primary">Mới Nhất</span>
            </h2>

            <p>
                Khám phá những bài viết hữu ích về đồ dùng học tập,
                <br class="d-lg-block d-none" />
                mẹo học tập hiệu quả và cách tổ chức góc học tập khoa học.
            </p>

        </div>

        <div class="row row-gap-4 mb-48">

            @if (ViewBag.LatestPosts != null && ((List<StationeryWebsite.Models.Post>)ViewBag.LatestPosts).Any())
            {
                int delay = 400;
                foreach (var post in (List<StationeryWebsite.Models.Post>)ViewBag.LatestPosts)
                {
                    <div class="col-lg-4 col-md-6 col-sm-6 wow fadeInUp animated"
                         data-wow-delay="@(delay)ms"
                         style="visibility: visible; animation-delay: @(delay)ms; animation-name: fadeInUp;">

                        <div class="blog-card">

                            <!-- Ảnh -->
                            <a href="@Url.Action("Detail", "Post", new { slug = post.slug, id = post.post_id })"
                               class="blog-image mb-8">

                                <img src="@(string.IsNullOrEmpty(post.image) ? Url.Content("~/Assets/Client/assets/media/blogs/blog-default.png") : post.image)"
                                     alt="@post.title"
                                     onerror="this.src='@Url.Content("~/Assets/Client/assets/media/blogs/blog-default.png")'" />

                            </a>

                            <!-- Nội dung -->
                            <div class="blog-text">

                                <!-- Meta -->
                                <p class="subtitle mb-16 fw-500 light-gray">
                                    By Admin • @(post.created_at?.ToString("dd MMM, yyyy") ?? "N/A")
                                </p>

                                <!-- Tiêu đề -->
                                <a href="@Url.Action("Detail", "Post", new { slug = post.slug, id = post.post_id })"
                                   class="h5 fw-700 font-sec mb-8 text-decoration-none medium-black">

                                    @post.title

                                </a>

                                <!-- Tóm tắt -->
                                <p class="mb-24">
                                    @(string.IsNullOrEmpty(post.summary)
                                        ? (post.content?.Length > 120 ? post.content.Substring(0, 120) + "..." : post.content)
                                        : (post.summary.Length > 120 ? post.summary.Substring(0, 120) + "..." : post.summary))
                                </p>

                                <!-- Read More -->
                                <a href="@Url.Action("Detail", "Post", new { slug = post.slug, id = post.post_id })"
                                   class="medium-black fw-700 font-sec text-decoration-underline">

                                    Read More

                                </a>

                            </div>

                        </div>

                    </div>

                    delay += 100;
                }
            }
            else
            {
                <!-- Fallback nếu không có bài viết -->
                <div class="col-12 text-center py-40">
                    <p class="text-muted">Chưa có bài viết nào. Quay lại sau nhé!</p>
                </div>
            }
        </div>

        <!-- Nút xem tất cả -->
        <div class="text-center mt-16 mb-40">
            <a href="@Url.Action("Index", "Post")" class="cus-btn">
                Xem tất cả bài viết <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>

    </div>

</section>
<!-- BLOG SECTION END -->