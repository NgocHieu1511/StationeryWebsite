@model IEnumerable<StationeryWebsite.Models.Product>

<!-- SALE START -->
<section class="best-seller-sec py-40">

    <img src="@Url.Content("~/Assets/Client/assets/media/images/element-1.png")"
         alt=""
         class="element-1" />

    <div class="container-2">

        <div class="heading mb-48 text-center wow fadeInUp animated"
             data-wow-delay="400ms">

            <h2 class="medium-black fw-700 mb-16">
                <span class="color-primary"> Sale</span> Products
            </h2>

            <p>
                Best products currently on sale
            </p>

        </div>

        <div class="row row-gap-4">

            @foreach (var item in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6">

                    <div class="latest-product-card">

                        <div class="image-box mb-16">

                            @if (item.is_sale)
                            {
                                <span class="sale-label subtitle fw-400 white">
                                    Sale
                                </span>
                            }

                            <a href="@Url.Action("Details", "SanPham", new { id = item.product_id })"
                               class="image">

                                <img src="@Url.Content(item.image)"
                                     class="product-image"
                                     alt="@item.name" />

                            </a>

                            <div class="side-icons">

                                <ul class="list-unstyled">

                                    <li>
                                        <a href="#">
                                            <i class="fa-light fa-heart"></i>
                                        </a>
                                    </li>

                                    <li>
                                        <a href="#"
                                           class="btn"
                                           data-bs-toggle="modal"
                                           data-bs-target="#productQuickView">

                                            <i class="fa-regular fa-eye"></i>

                                        </a>
                                    </li>

                                </ul>

                            </div>

                            <a href="@Url.Action("AddToCart", "GioHang", new { id = item.product_id })"
                               class="cus-btn">

                                <span class="btn-text">
                                    Add Cart
                                </span>

                                <span>
                                    Go to Cart
                                </span>

                            </a>

                        </div>

                        <div class="product-desc">

                            <div>

                                <a href="@Url.Action("Details", "SanPham", new { id = item.product_id })"
                                   class="product-title h6 fw-700 mb-8">

                                    @item.name

                                </a>

                                <h5 class="medium-black fw-700">

                                    @item.price đ

                                </h5>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</section>
<!-- SALE END -->
