            </div>

            <!-- Benefit Item -->
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="benefit-block">
                    <div class="icon-box mb-16">
                        <!-- SVG giữ nguyên -->
                    </div>

                    <h5 class="fw-700 medium-black mb-16">Quality Products</h5>

                    <p class="mb-24">
                        We provide high-quality stationery products suitable for students and offices.
                    </p>

                    <a href="@Url.Action("About", "Home")" class="cus-btn-2">
                        <span class="btn-text">Read More</span>
                        <span>About Us</span>
                    </a>
                </div>
            </div>

            <!-- Benefit Item -->
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="benefit-block">
                    <div class="icon-box mb-16">
                        <!-- SVG giữ nguyên -->
