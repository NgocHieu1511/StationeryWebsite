
@model PagedList.IPagedList<StationeryWebsite.Models.Product>

@{
    ViewBag.Title = "SanPham";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}



<!-- TITLE BANNER START -->
<section class="title-banner bg-sec">

    <div class="container-2">

        <div class="title-wrapper">

            <div class="row align-items-center justify-content-between">

                <div class="col-lg-6 col-md-6 col-sm-6">

                    <h1 class="fw-700 medium-black text-sm-start text-center">
                        Shop
                    </h1>

                </div>

                <div class="col-lg-6 col-md-6 col-sm-6 d-sm-block d-none">

                    <div class="text-end">

                        <img src="@Url.Content("~/Assets/Client/assets/media/banner/title-banner-image.png")"
                             alt="" />

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
<!-- TITLE BANNER END -->


<section class="shop-section py-80">
    <div class="container-2">

        <div class="row">

            <!-- SIDEBAR -->
            <div class="col-lg-3">

                <div class="sidebar">
                    <form action="index.html" method="post" class="search-bar-container mb-24">
                        <div class="search-input-block">
                            <input type="text" name="search" placeholder="Search Here...">
                        </div>
                        <button type="submit">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                 viewBox="0 0 24 24" fill="none">
                                <path d="M9.74062 0C15.1116 0 19.4812 4.36964 19.4812 9.74063C19.4812 12.1734 18.5847 14.4008 17.1047 16.1097L23.7941 22.7997C24.0687 23.0743 24.0686 23.5195 23.794 23.7941C23.5194 24.0687 23.0743 24.0686 22.7997 23.7941L16.1104 17.1041C14.4014 18.5845 12.1738 19.4813 9.74062 19.4813C4.36964 19.4813 0 15.1116 0 9.74063C0 4.36964 4.36964 0 9.74062 0ZM9.74062 18.075C14.3362 18.075 18.075 14.3362 18.075 9.74063C18.075 5.14505 14.3362 1.40625 9.74062 1.40625C5.14505 1.40625 1.40625 5.14505 1.40625 9.74063C1.40625 14.3362 5.14505 18.075 9.74062 18.075Z"
                                      fill="white" />
                            </svg>
                        </button>
                    </form>
                    <div class="category-block box-2 mb-32 wow fadeInUp animated" data-wow-delay="200ms">
                        <div class="title" data-count="2">
                            <h6 class="fw-600 font-sec medium-black">Availablity</h6>
                            <span>
                                <i class="fa-light fa-chevron-up"></i>
                            </span>
                        </div>
                        <div class="content-block mt-24">
                            <div class="d-flex align-items-center justify-content-between mb-12">
                                <div class="cus-checkBox">
                                    <input type="checkbox" id="inStock" class="inp-cbx">
                                    <label for="inStock" class="cbx">
                                        In Stock
                                    </label>
                                </div>
                                <p>(05)</p>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-12">
                                <div class="cus-checkBox">
                                    <input type="checkbox" id="outStock" class="inp-cbx">
                                    <label for="outStock" class="cbx">
                                        Out Stock
                                    </label>
                                </div>
                                <p>(08)</p>
                            </div>
                        </div>
                    </div>
                    <div class="hr-line line-2 mb-24"></div>
                    <div class="category-block box-5 wow fadeInUp animated mb-32 animated"
                         data-wow-delay="200ms">
                        <div class="title mb-24" data-count="5">
                            <h6 class="fw-600 font-sec medium-black">Filter By Price</h6>
                            <span>
                                <i class="fa-light fa-chevron-up"></i>
                            </span>
                        </div>
                        <div class="content-block">
                            <div class="wrapper">
                                <div class="price-input mb-24">
                                    <div class="field">
                                        <div class="medium-black mb-4p">From</div>
                                        <div class="sidebar-price-block">
                                            <p class="price-sign">$</p>
                                            <input type="number" class="input-min dark-gray" value="2500">
                                        </div>
                                    </div>
                                    <div class="field">
                                        <div class="medium-black mb-4p">To</div>
                                        <div class="sidebar-price-block">
                                            <p class="price-sign">$</p>
                                            <input type="number" class="input-max dark-gray" value="7500">
                                        </div>
                                    </div>
                                </div>
                                <div class="slider">
                                    <div class="progress"></div>
                                </div>
                                <div class="range-input">
                                    <input type="range" class="range-min" min="0" max="10000" value="2500"
                                           step="100">
                                    <input type="range" class="range-max" min="0" max="10000" value="7500"
                                           step="100">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="hr-line line-2 mb-24"></div>
                    <div class="category-block box-1 mb-32 wow fadeInUp animated" data-wow-delay="300ms">
                        <div class="title" data-count="1">
                            <h6 class="fw-600 font-sec medium-black">Blog Categories</h6>
                            <span>
                                <i class="fa-light fa-chevron-up"></i>
                            </span>
                        </div>
                        <div class="content-block mt-24">
                            <div class="d-flex align-items-center justify-content-between mb-12">
                                <div class="cus-checkBox">
                                    <input type="checkbox" id="sketchbooks" class="inp-cbx">
                                    <label for="sketchbooks" class="cbx">
                                        Sketchbooks
                                    </label>
                                </div>
                                <p>(05)</p>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-12">
                                <div class="cus-checkBox">
                                    <input type="checkbox" id="hardcover" class="inp-cbx">
                                    <label for="hardcover" class="cbx">
                                        Hardcover Notebooks
                                    </label>
                                </div>
                                <p>(08)</p>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-12">
                                <div class="cus-checkBox">
                                    <input type="checkbox" id="markers" class="inp-cbx">
                                    <label for="markers" class="cbx">
                                        Markers
                                    </label>
                                </div>
                                <p>(12)</p>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-12">
                                <div class="cus-checkBox">
                                    <input type="checkbox" id="brownies" class="inp-cbx">
                                    <label for="brownies" class="cbx">
                                        Choco-Luxe Brownies
                                    </label>
                                </div>
                                <p>(12)</p>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-12">
                                <div class="cus-checkBox">
                                    <input type="checkbox" id="smallAnimals" class="inp-cbx">
                                    <label for="smallAnimals" class="cbx">
                                        Small Animals
                                    </label>
                                </div>
                                <p>(12)</p>
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="cus-checkBox">
                                    <input type="checkbox" id="caramelCookies" class="inp-cbx">
                                    <label for="caramelCookies" class="cbx">
                                        Caramel Swirl Cookies
                                    </label>
                                </div>
                                <p>(04)</p>
                            </div>
                        </div>
                    </div>
                    <div class="hr-line line-2 mb-24"></div>
                    <div class="category-block box-4 mb-24 wow fadeInUp animated" data-wow-delay="400ms">
                        <div class="title" data-count="4">
                            <h6 class="fw-600 font-sec medium-black">Tags</h6>
                            <span>
                                <i class="fa-light fa-chevron-up"></i>
                            </span>
                        </div>
                        <div class="content-block mt-24">
                            <div class="tags-wrapper">
                                <a href="shop-grid-sidebar.html" class="tag">
                                    <p>Pencils</p>
                                </a>
                                <a href="shop-grid-sidebar.html" class="tag">
                                    <p>Notebooks</p>
                                </a>
                                <a href="shop-grid-sidebar.html" class="tag">
                                    <p>Pens & Markers</p>
                                </a>
                                <a href="shop-grid-sidebar.html" class="tag">
                                    <p>Art Supplies</p>
                                </a>
                                <a href="shop-grid-sidebar.html" class="tag">
                                    <p>Organizers</p>
                                </a>
                                <a href="shop-grid-sidebar.html" class="tag">
                                    <p>Craft Supplies</p>
                                </a>
                                <a href="shop-grid-sidebar.html" class="tag">
                                    <p>Planners & Journals</p>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="sidebar-promotional-image w-100 object-fit-cover br-12 wow fadeInUp animated"
                         data-wow-delay="500ms">
                        <img src="assets/media/images/sidebar-image.png" alt=""
                             class="w-100 object-fit-cover br-12">
                    </div>
                </div>

            </div>

            <!-- PRODUCT LIST -->
            <div class="col-lg-9">

                @Html.Action("ProductPartial", "SanPham")

            </div>

        </div>

    </div>
</section>
