@model IEnumerable<StationeryWebsite.Models.Product>

<!-- FEATURED PRODUCT START -->
<section class="featured-product-sec pt-40 pb-80">
    <div class="container-2">

        <div class="heading mb-48 text-center wow fadeInUp animated" data-wow-delay="400ms">
            <h2 class="medium-black fw-700 mb-16">
                Related <span class="color-primary">Products</span>
            </h2>
        </div>

        <div class="featured-product-slider">

            @foreach (var item in Model)
            {
                <div class="latest-product-card">

                    <div class="image-box mb-16">

                        @if (item.is_sale == true)
                        {
                            <span class="sale-label subtitle fw-400 white">
                                Sale
                            </span>
                        }

                        <!-- PRODUCT IMAGE -->
                        <a href="@Url.Action("Details", "SanPham", new { id = item.product_id })"
                           class="image">

                            <img src="@Url.Content(item.image)"
                                 class="product-image"
                                 alt="@item.name">
                        </a>

                        <!-- ICONS -->
                        <div class="side-icons">

                            <ul class="list-unstyled">

                                <li>
                                    <a href="#">
                                        <i class="fa-light fa-heart"></i>
                                    </a>
                                </li>

                                <li>
                                    <a href="@Url.Action("Details", "SanPham", new { id = item.product_id })">

                                        <i class="fa-regular fa-eye"></i>

                                    </a>
                                </li>

                            </ul>

                        </div>

                        <!-- ADD TO CART -->
                        <a href="@Url.Action("AddToCart", "GioHang", new { id = item.product_id })"
                           class="cus-btn">

                            <span class="btn-text">
                                Add Cart
                            </span>

                            <span>
                                Go to Cart
                            </span>

                        </a>

                    </div>

                    <!-- PRODUCT INFO -->
                    <div class="product-desc">

                        <div>

                            <a href="@Url.Action("Details", "SanPham", new { id = item.product_id })"
                               class="product-title h6 fw-700 mb-8">

                                @item.name

                            </a>

                            <div class="d-flex align-items-center gap-8 justify-content-center mb-8">

                                <div class="rating-stars">
                                    ★★★★★
                                </div>

                                <p class="fw-500">
                                    (02)
                                </p>

                            </div>

                            <!-- PRICE -->
                            @if (item.discount.HasValue && item.discount > 0)
                            {
                                var newPrice = item.price - (item.price * item.discount.Value / 100);

                                <div class="d-flex align-items-center gap-8 justify-content-center">

                                    <h5 class="medium-black fw-700 text-danger">
                                        @String.Format("{0:N0}₫", newPrice)
                                    </h5>

                                    <del class="text-muted">
                                        @String.Format("{0:N0}₫", item.price)
                                    </del>

                                </div>
                            }
                            else
                            {
                                <h5 class="medium-black fw-700">
                                    @String.Format("{0:N0}₫", item.price)
                                </h5>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
</section>
<!-- FEATURED PRODUCT END -->